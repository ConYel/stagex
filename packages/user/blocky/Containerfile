FROM stagex/pallet-go AS build
ARG VERSION
ENV SOURCE_DATE_EPOCH=1
ADD fetch/blocky-v${VERSION}.tar.gz .
ENV GOPATH=/cache/go
ENV GOCACHE=/cache/
ENV GOWORK=off
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org
ENV CGO_ENABLED=0
ENV GOHOSTOS=linux
ENV GOHOSTARCH=amd64
WORKDIR /blocky-${VERSION}
RUN go mod download
RUN --network=none <<-EOF
	go build -trimpath \
	  -ldflags "-s -w -X github.com/0xERR0R/blocky/util.Version=v${VERSION}" \
	  -o /rootfs/usr/bin/blocky .
	mkdir -p /rootfs/usr/share/licenses/blocky
	cp LICENSE /rootfs/usr/share/licenses/blocky/
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ENV SOURCE_DATE_EPOCH=1
ADD fetch/v${VERSION}.tar.gz .
WORKDIR /ferrous-dns-${VERSION}
ADD ferrous-dns-remove-mimalloc.patch .
RUN --network=none <<-EOF
	patch -p1 < ferrous-dns-remove-mimalloc.patch
EOF
RUN cargo fetch
ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN --network=none <<-EOF
	ARCH="$(uname -m)"
	cargo build \
	  --frozen \
	  --release \
	  --target "${ARCH}-unknown-linux-musl" \
	  --bin ferrous-dns
	install -vDm755 -t /rootfs/usr/bin target/${ARCH}-unknown-linux-musl/release/ferrous-dns
	install -vDm644 -t /rootfs/usr/share/licenses/ferrous-dns LICENSE-MIT
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

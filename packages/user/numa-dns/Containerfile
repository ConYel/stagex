FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ENV SOURCE_DATE_EPOCH=1
ADD fetch/v${VERSION}.tar.gz .
WORKDIR /numa-${VERSION}
RUN cargo fetch --locked
ENV RUSTFLAGS="-C target-feature=+crt-static"
RUN --network=none <<-EOF
	ARCH="$(uname -m)"
	cargo build \
	  --frozen \
	  --release \
	  --target "${ARCH}-unknown-linux-musl" \
	  --bin numa
	mkdir -p /rootfs/usr/bin /rootfs/usr/share/licenses/numa-dns
	cp target/${ARCH}-unknown-linux-musl/release/numa /rootfs/usr/bin/
	cp LICENSE /rootfs/usr/share/licenses/numa-dns/
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
